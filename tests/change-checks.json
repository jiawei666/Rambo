{
  "schema": "rambo.change-checks.v1",
  "description": "开发 Agent 的最小检查矩阵。按模块与共享边界选择，文件路径用于细化；合并本轮命中的所有检查并去重。",
  "checks": {
    "typecheck": {
      "label": "TypeScript 类型检查",
      "command": ["npm", "run", "typecheck"],
      "cost": 10
    },
    "backend-unit": {
      "label": "相关后端测试",
      "command": ["node", "--test", "{targets}"],
      "cost": 20
    },
    "acceptance-structure": {
      "label": "验收目录与台账结构",
      "command": ["npm", "run", "test:catalog"],
      "cost": 15
    },
    "acceptance-tests": {
      "label": "验收流程测试",
      "command": ["npm", "run", "test:acceptance"],
      "cost": 30
    },
    "electron-e2e": {
      "label": "相关 Electron E2E",
      "command": ["npm", "run", "test:e2e", "--", "{targets}"],
      "cost": 100
    },
    "build": {
      "label": "Electron 构建",
      "command": ["npm", "run", "build"],
      "cost": 40
    }
  },
  "areas": [
    {
      "id": "release-tooling",
      "label": "双平台发版 Skill、产物与 App Server 校验",
      "paths": [
        ".agents/skills/rambo-release/**",
        "tests/backend/release-package.test.mjs",
        ".github/workflows/windows-build.yml",
        "config/runtime-targets.json"
      ],
      "checks": ["backend-unit", "acceptance-structure"],
      "backendTargets": ["tests/backend/release-package.test.mjs"],
      "reason": "发版必须同时验证平台产物、架构和各自内置的 Codex App Server"
    },
    {
      "id": "docs-decisions",
      "label": "产品决策、验收文档与证据",
      "paths": ["AGENTS.md", "README.md", "docs/**", ".agents/skills/**"],
      "checks": ["acceptance-structure"],
      "reason": "文档或规则结构变化必须保持决策、矩阵、计划和目录一致"
    },
    {
      "id": "acceptance-tests",
      "label": "验收脚本与规则目录",
      "paths": [
        "tests/acceptance/**",
        "tests/change-checks.json",
        "scripts/verify.mjs",
        "scripts/change-checks.mjs"
      ],
      "checks": ["acceptance-structure", "acceptance-tests"],
      "reason": "测试编排或规则映射本身变化"
    },
    {
      "id": "electron-test-harness",
      "label": "Electron 测试共享夹具",
      "paths": ["tests/e2e/fixtures/**"],
      "checks": ["electron-e2e"],
      "e2eTargets": [
        "tests/e2e/private-chat.spec.mjs",
        "tests/e2e/group-chat.spec.mjs",
        "tests/e2e/avatar-picker.spec.mjs",
        "tests/e2e/media-preview.spec.mjs",
        "tests/e2e/runtime-startup.spec.mjs"
      ],
      "reason": "共享启动、profile 与重启生命周期会影响全部 Electron 流程"
    },
    {
      "id": "electron-avatar-picker",
      "label": "Bot 头像选择与动态预览",
      "paths": [
        "src/renderer/robot-avatar.tsx",
        "src/renderer/vendor/agent-robot-avatar/src/agent-robot-avatar-core.js",
        "src/renderer/vendor/agent-robot-avatar/UPSTREAM.md",
        "tests/e2e/avatar-picker.spec.mjs"
      ],
      "checks": ["typecheck", "electron-e2e"],
      "e2eTargets": ["tests/e2e/avatar-picker.spec.mjs"],
      "reason": "头像眼型首帧和鼠标跟随需要真实 Electron 渲染验证"
    },
    {
      "id": "desktop-platform",
      "label": "macOS 与 Windows 桌面平台抽象",
      "paths": [
        "src/shared/platform.ts",
        "src/main/platform/**",
        "scripts/platform-target.mjs",
        "tests/backend/platform-helpers.test.mjs",
        "tests/backend/platform-paths.test.mjs",
        "tests/backend/platform-process.test.mjs",
        "tests/backend/platform-target.test.mjs",
        "tests/backend/platform-archive.test.mjs",
        "tests/backend/platform-fs.test.mjs",
        "tests/backend/desktop-shell.test.mjs",
        "tests/backend/login-item.test.mjs",
        "tests/backend/system-indicators.test.mjs"
      ],
      "checks": ["typecheck", "backend-unit"],
      "backendTargets": [
        "tests/backend/platform-helpers.test.mjs",
        "tests/backend/platform-paths.test.mjs",
        "tests/backend/platform-process.test.mjs",
        "tests/backend/platform-target.test.mjs",
        "tests/backend/platform-archive.test.mjs",
        "tests/backend/platform-fs.test.mjs",
        "tests/backend/desktop-shell.test.mjs",
        "tests/backend/login-item.test.mjs",
        "tests/backend/system-indicators.test.mjs"
      ],
      "reason": "平台路径、进程启动、归档、登录项、托盘和窗口外壳必须同时覆盖 macOS 与 Windows 语义"
    },
    {
      "id": "composer-attachments",
      "label": "输入框附件与剪贴板图片",
      "paths": [
        "src/shared/composer-attachments.ts",
        "src/main/composer-attachment-cleanup.ts",
        "tests/backend/composer-attachments.test.mjs",
        "tests/backend/composer-attachment-cleanup.test.mjs"
      ],
      "checks": ["typecheck", "backend-unit"],
      "backendTargets": [
        "tests/backend/composer-attachments.test.mjs",
        "tests/backend/composer-attachment-cleanup.test.mjs"
      ],
      "reason": "附件路径、图片解析与临时文件保留策略需要纯逻辑覆盖"
    },
    {
      "id": "backend-tests",
      "label": "后端测试文件",
      "paths": ["tests/backend/**/*.test.mjs", "tests/backend/*.test.mjs"],
      "checks": ["backend-unit"],
      "backendTargets": ["{path}"],
      "reason": "测试文件自身改动只运行该测试，不扩展到全部后端测试"
    },
    {
      "id": "shared-contracts",
      "label": "跨进程契约与 IPC",
      "paths": ["src/shared/**", "src/preload/**", "src/main/index.ts"],
      "checks": ["typecheck", "backend-unit"],
      "backendTargets": ["tests/backend/host.test.mjs"],
      "reason": "跨进程边界变化会同时影响宿主和渲染层"
    },
    {
      "id": "connectors",
      "label": "连接应用、授权与邮件 Adapter",
      "paths": [
        "src/main/connectors.ts",
        "src/main/connector-credentials.ts",
        "src/main/gmail-oauth-app-config.ts",
        "src/main/gmail-oauth.ts",
        "src/main/gmail-adapter.ts",
        "src/main/gmail-imap-adapter.ts",
        "src/main/imap-smtp-mail-adapter.ts",
        "src/main/qq-mail-adapter.ts",
        "src/main/mail-adapter.ts",
        "src/main/mail-runtime.ts",
        "src/main/mail-tools.ts",
        "src/main/bot-credential-tools.ts",
        "src/main/bot-secret-tools.ts",
        "tests/backend/bot-credential-tools.test.mjs",
        "tests/backend/bot-secret-tools.test.mjs",
        "tests/backend/connector-credentials.test.mjs",
        "tests/backend/gmail-oauth.test.mjs",
        "tests/backend/gmail-adapter.test.mjs",
        "tests/backend/gmail-imap-adapter.test.mjs",
        "tests/backend/qq-mail-adapter.test.mjs",
        "tests/backend/mail-runtime.test.mjs",
        "tests/backend/mail-tools.test.mjs"
      ],
      "checks": ["typecheck", "backend-unit"],
      "backendTargets": [
        "tests/backend/bot-credential-tools.test.mjs",
        "tests/backend/bot-secret-tools.test.mjs",
        "tests/backend/connector-credentials.test.mjs",
        "tests/backend/gmail-oauth.test.mjs",
        "tests/backend/gmail-adapter.test.mjs",
        "tests/backend/gmail-imap-adapter.test.mjs",
        "tests/backend/qq-mail-adapter.test.mjs",
        "tests/backend/mail-runtime.test.mjs",
        "tests/backend/mail-tools.test.mjs",
        "tests/backend/host.test.mjs",
        "tests/backend/store.test.mjs"
      ],
      "reason": "Provider、凭证、OAuth、Adapter 与动态工具共享授权边界，需同时验证协议映射和 Host 执行时校验"
    },
    {
      "id": "electron-runtime-startup",
      "label": "内置 Codex App Server、独立更新和 Codex Home 复制",
      "paths": [
        "src/main/runtime.ts",
        "src/main/runtime-home.ts",
        "scripts/prepare-runtime.mjs",
        "scripts/sign-mac.mjs",
        "package.json",
        "tests/e2e/runtime-startup.spec.mjs",
        "tests/e2e/packaged-app.spec.mjs"
      ],
      "checks": ["electron-e2e"],
      "e2eTargets": [
        "tests/e2e/runtime-startup.spec.mjs",
        "tests/e2e/packaged-app.spec.mjs"
      ],
      "reason": "真实 Electron 验证内置运行时、单独更新、白名单复制、账号状态和运行时重启"
    },
    {
      "id": "main-host-runtime",
      "label": "主进程、Host、Store、Runtime",
      "paths": [
        "src/main/bot-data.ts",
        "src/main/chat-content-tools.ts",
        "src/main/host.ts",
        "src/main/login-item.ts",
        "src/main/realtime-audio-bridge.ts",
        "src/main/routine-schedule.ts",
        "src/main/routine-scheduler.ts",
        "src/main/runtime.ts",
        "src/main/runtime-home.ts",
        "src/main/store.ts"
      ],
      "checks": ["typecheck", "backend-unit"],
      "backendTargets": ["tests/backend/{stem}.test.mjs"],
      "reason": "本机执行、持久化和宿主行为由后端集成测试覆盖"
    },
    {
      "id": "bot-resources",
      "label": "Bot Skills、MCP、Apps 与 Plugins 资源目录",
      "paths": [
        "src/main/bot-resources.ts",
        "src/main/bot-resource-tools.ts",
        "src/main/managed-skills.ts",
        "src/main/direct-mcp.ts",
        "tests/backend/bot-resources.test.mjs",
        "tests/backend/bot-resource-tools.test.mjs",
        "tests/backend/managed-skills.test.mjs",
        "tests/backend/direct-mcp.test.mjs"
      ],
      "checks": ["typecheck", "backend-unit"],
      "backendTargets": [
        "tests/backend/bot-resources.test.mjs",
        "tests/backend/bot-resource-tools.test.mjs",
        "tests/backend/managed-skills.test.mjs",
        "tests/backend/direct-mcp.test.mjs",
        "tests/backend/store.test.mjs",
        "tests/backend/host.test.mjs"
      ],
      "reason": "资源发现、目录同步和逐 Bot 开关共享同一标识与持久化边界"
    },
    {
      "id": "playwright-extension-verifier",
      "label": "Playwright Chrome 扩展首次连接验证",
      "paths": [
        "src/main/playwright-extension-verifier.ts",
        "tests/backend/playwright-extension-verifier.test.mjs"
      ],
      "checks": ["typecheck", "backend-unit"],
      "backendTargets": ["tests/backend/playwright-extension-verifier.test.mjs"],
      "reason": "MCP stdio 握手、Chrome 标签确认、只读快照和取消清理由单独进程模块验证"
    },
    {
      "id": "wechat-connector",
      "label": "微信本机连接、查询 Tool 与媒体边界",
      "paths": [
        "src/main/wechat-adapter.ts",
        "src/main/wechat-sqlcipher.ts",
        "src/main/wechat-tools.ts",
        "src/main/wechat-platform-types.ts",
        "src/main/wechat-connector-common.ts",
        "src/main/wechat-connector-macos.ts",
        "src/main/wechat-connector-windows.ts",
        "src/main/wechat-connector-wizard.ts",
        "native/wechat-windows-key-scanner/**",
        "scripts/build-native-media.mjs",
        "tests/backend/wechat-connector-wizard.test.mjs",
        "tests/backend/wechat-adapter.test.mjs",
        "tests/backend/wechat-sqlcipher.test.mjs",
        "tests/backend/wechat-tools.test.mjs"
      ],
      "checks": ["typecheck", "backend-unit"],
      "backendTargets": [
        "tests/backend/wechat-connector-wizard.test.mjs",
        "tests/backend/wechat-adapter.test.mjs",
        "tests/backend/wechat-tools.test.mjs",
        "tests/backend/connector-credentials.test.mjs",
        "tests/backend/host.test.mjs",
        "tests/backend/store.test.mjs"
      ],
      "reason": "时间、分页、能力状态、Grant 与凭证边界必须用隔离夹具验证；真实微信读取另行验收"
    },
    {
      "id": "electron-private-chat",
      "label": "私聊与连接应用 Electron 流程",
      "paths": ["tests/e2e/private-chat.spec.mjs"],
      "checks": ["electron-e2e"],
      "e2eTargets": ["tests/e2e/private-chat.spec.mjs"],
      "reason": "私聊、连接应用市场和 Bot 授权属于真实 Electron 用户流程"
    },
    {
      "id": "electron-voice-waveform-analysis",
      "label": "真实 Web Audio 语音频谱分析与 PCM 播放",
      "paths": [
        "src/renderer/voice-playback.ts",
        "src/renderer/voice-waveform-model.ts",
        "tests/backend/voice-playback.test.mjs",
        "tests/backend/voice-waveform-model.test.mjs",
        "tests/e2e/voice-waveform-analysis.spec.mjs"
      ],
      "checks": ["backend-unit", "electron-e2e"],
      "backendTargets": [
        "tests/backend/voice-playback.test.mjs",
        "tests/backend/voice-waveform-model.test.mjs"
      ],
      "e2eTargets": [
        "tests/e2e/voice-waveform-analysis.spec.mjs",
        "tests/e2e/private-chat.spec.mjs"
      ],
      "reason": "频段分析与语音活动门控同时需要纯状态和真实 Web Audio 链路验证"
    },
    {
      "id": "electron-file-preview",
      "label": "聊天文件预览与本机打开",
      "paths": [
        "src/main/index.ts",
        "src/preload/index.ts",
        "src/renderer/message-content.tsx",
        "src/renderer/message-content.css",
        "tests/e2e/media-preview.spec.mjs"
      ],
      "checks": ["typecheck", "electron-e2e"],
      "e2eTargets": ["tests/e2e/media-preview.spec.mjs"],
      "reason": "资源授权、媒体流、保存和系统文件操作由隔离 Electron 流程验证"
    },
    {
      "id": "renderer",
      "label": "渲染层与样式",
      "paths": ["src/renderer/**"],
      "checks": ["typecheck"],
      "reason": "优先类型检查；只有改变真实用户交互时才追加对应 Electron E2E"
    },
    {
      "id": "build-config",
      "label": "构建与打包配置",
      "paths": [
        "electron.vite.config.ts",
        "playwright.config.mjs",
        "package.json",
        "package-lock.json",
        "config/**",
        "native/**",
        "scripts/build-native-media.mjs",
        "scripts/package-desktop.mjs",
        "scripts/prepare-ffmpeg.mjs",
        "scripts/prepare-icon.mjs",
        "scripts/prepare-runtime.mjs",
        "scripts/sign-mac.mjs",
        "assets/branding/app.ico",
        ".github/workflows/**"
      ],
      "checks": ["typecheck", "build"],
      "reason": "平台目标、原生工具或打包配置变化必须验证 Electron 产物可生成"
    },
    {
      "id": "package-manifest",
      "label": "package 清单",
      "paths": ["package.json"],
      "checks": ["acceptance-structure"],
      "reason": "先检查清单结构与规则一致性；只有依赖或构建入口变化才额外构建"
    },
    {
      "id": "unregistered-main",
      "label": "尚未登记的新主进程文件",
      "paths": ["src/main/**"],
      "checks": ["typecheck", "backend-unit"],
      "backendTargets": ["tests/backend/{stem}.test.mjs"],
      "reason": "新主进程文件需要补充对应测试映射；当前先跑类型检查及已存在的同名测试"
    },
    {
      "id": "unregistered-renderer",
      "label": "尚未登记的新渲染文件",
      "paths": ["src/renderer/**"],
      "checks": ["typecheck"],
      "reason": "新渲染文件先做类型检查；涉及真实交互时应追加对应 Electron E2E",
      "fallback": true
    }
  ],
  "escalation": [
    {
      "when": "修改了真实 Electron 用户流程、窗口导航或关键交互",
      "add": ["electron-e2e"],
      "requiresApproval": false,
      "targets": ["tests/e2e/private-chat.spec.mjs", "tests/e2e/group-chat.spec.mjs", "tests/e2e/media-preview.spec.mjs"]
    },
    {
      "when": "用户明确要求完整验收、候选版本或发布验证",
      "add": ["acceptance-structure", "acceptance-tests", "electron-e2e", "build"],
      "requiresApproval": false
    }
  ],
  "rules": [
    "先列出命中的模块、选中检查和未选原因，再执行检查。",
    "所有命中的检查合并去重，按 cost 从低到高执行。",
    "模块内必跑项不能省略；不适用时说明具体原因。",
    "默认不运行全量 verify:fast、verify:candidate 或 accept:release。",
    "新增模块或测试时补充映射；放宽或删除现有门禁需要用户明确同意。"
  ]
}
